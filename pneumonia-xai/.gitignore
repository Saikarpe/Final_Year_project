# Data (G-2). The Kermany corpus is redistributed by Kaggle/Mendeley, not by
# this repo -- see README for the download step and docs/dataset_datasheet.md
# for provenance/licence.
dataset/
__MACOSX/

# Trained weights -- large binaries don't belong in git history. Regenerate
# with `python scripts/train.py` (or the Makefile's `train` target).
models/*.h5
!models/.gitkeep

# The archived pre-M-1b VGG16 evaluation IS committed on purpose: it is the
# only record of that model's numbers and is not being regenerated.
!models/baseline_vgg16_*/

# Runtime artefacts
app/static/uploads/*
!app/static/uploads/.gitkeep
audit.db
runs/
*.log

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
